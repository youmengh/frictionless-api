# Frictionless API — environment configuration
#
# All variables are OPTIONAL. The defaults shown below are baked into the code,
# so the server runs with no .env file at all. Copy this file to `.env` and
# uncomment a line only to override its default.

# HTTP port the API listens on.
# PORT=3001

# Allowed CORS origin(s) for the browser UI. Comma-separate multiple origins.
# CORS_ORIGIN=http://localhost:5173

# How long (minutes) fetched fund/ETF/stock data is cached in memory per symbol.
# CACHE_TTL_MINUTES=60
